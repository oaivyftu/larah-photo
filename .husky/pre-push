# The full pre-commit check set, plus the test suite and a production build.
#
# Deliberately not a lighter version of pre-commit (spec Edge Cases): the same
# lint/type steps run again, because what was committed one file at a time
# still has to hold together as a whole before it leaves the machine.
#
# The test suite lives here and only here. It is the slowest check of the set,
# and paying it per commit taxed the small, frequent commits a commit-time gate
# should stay clear of; running it once per push keeps the guarantee that
# matters — nothing reaches the remote with a failing test.
#
# lint runs unscoped here — there are no "staged files" during a push, so the
# whole project is linted rather than a diff.
#
# Still no E2E (FR-007, research.md §4): Playwright needs a booted app, and a
# broken build already fails this hook without starting a browser.
#
# The design-system audit joins here, and only here, as of feature 010. It was
# left out of the hooks entirely when it was written, for a good reason: it
# failed on every run, so as a gate it would have been noise a developer learns
# to skip. The tree passes it now, which is what makes it a gate rather than a
# complaint. Tree-wide, so pre-push rather than pre-commit, and 0.05s beside a
# next build.

echo "▶ lint         (eslint, whole project, warnings fail)"
npx eslint --max-warnings=0 || { echo "✖ pre-push failed at: lint"; exit 1; }

echo "▶ typecheck    (tsc --noEmit, whole project)"
npm run typecheck || { echo "✖ pre-push failed at: typecheck"; exit 1; }

echo "▶ test         (vitest run, whole project)"
npm test || { echo "✖ pre-push failed at: test"; exit 1; }

echo "▶ design-system (audit, whole tree)"
npm run audit:design-system || { echo "✖ pre-push failed at: design-system"; exit 1; }

echo "▶ build        (next build, production)"
npm run build || { echo "✖ pre-push failed at: build"; exit 1; }

echo "✔ pre-push passed"
