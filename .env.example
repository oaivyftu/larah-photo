# Public origin. Every canonical, Open Graph URL, sitemap entry and JSON-LD id
# is built from this, so it must be the real domain in production — the build
# refuses to run if indexing is on while this still points at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engine visibility, opt-in. Set to "true" on Production only; preview
# and development deployments stay noindex.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01

# Shared secret for the Sanity publish webhook that POSTs to /api/revalidate.
# Must match the secret configured on the webhook in Sanity manage.
SANITY_REVALIDATE_SECRET=your_webhook_secret
